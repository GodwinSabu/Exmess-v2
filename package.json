{
  "name": "superapp",
  "type": "module",
  "private": true,

  "workspaces": [
    "dbProcessor",
    "engine",
    "poller",
    "server",
    "frontend",
    "packages/*"
  ],

  "scripts": {
    "infra": "docker compose up -d",
    "db:migrate": "bun run --cwd packages/db migrate",
    "dev": "bun run scripts/dev.ts"
  },

  "devDependencies": {
    "@types/bun": "latest"
  },

  "peerDependencies": {
    "typescript": "^5"
  }
}
