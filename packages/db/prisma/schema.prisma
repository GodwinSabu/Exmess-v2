generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}


model Asset {
  id      Int     @id @default(autoincrement())
  symbol  String  @unique
  trades  Trade[]
}

model Trade {
  id          Int      @id @default(autoincrement())
  orderId     String   @unique
  openPrice   Float
  closePrice  Float?
  leverage    Int
  pnl         Float?
  liquidated  Boolean
  tradeType   TradeType
  createdAt   DateTime @default(now())

  userId   Int
  user     User @relation(fields: [userId], references: [id])

  assetId  Int
  asset    Asset @relation(fields: [assetId], references: [id])
}

model Snapshot {
  id           Int      @id @default(autoincrement())
  openOrders   Json
  closedOrders Json
  balances     Json
  createdAt    DateTime @default(now())
}

enum TradeType {
  LONG
  SHORT
}
model User {
  id     Int     @id @default(autoincrement())
  email  String  @unique
  trades Trade[]
}
